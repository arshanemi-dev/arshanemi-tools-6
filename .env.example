# ═══════════════════════════════════════════════════════════════════════════════
# arshanemi-tools-6 — Product Research (marketplace category rankings)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Connected mode ───────────────────────────────────────────────────────────
# "true"  → /api/auth/* and /api/admin/theme proxy to the root admin panel at
#           NEXT_PUBLIC_ADMIN_API_URL (same accounts, same coin wallet).
# "false" → local mode: auth reads/writes this app's own JSON store.
NEXT_PUBLIC_IS_CONNECT=true
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# ── Billing ──────────────────────────────────────────────────────────────────
# Searches are metered by the admin panel's POST /api/wallet/deduct against
# the `pr-search` feature of the `product-research` tool (Settings → Tools
# Catalog — seed it with the hub's `npm run db:sync-product-research`). A
# user's first search is free; each later NEW search = 1 × pr-search (10
# coins). Reopening / refreshing / exports / Import Sheet are always free.
# "false" → every search is free (no coin calls at all).
NEXT_PUBLIC_IS_PAID=true

# ── OTP ──────────────────────────────────────────────────────────────────────
# "true" bypasses every OTP step (dev/staging only).
NEXT_PUBLIC_IS_OTP_Verifications_Disable=false

# ── UI flags ─────────────────────────────────────────────────────────────────
# "true" → hides the top navbar (DashboardTopbar) on every page.
NEXT_PUBLIC_IS_Header_Hide=false
# "true" → shows a floating Profile/Logout shortcuts menu bottom-right on /profile.
NEXT_PUBLIC_SHOW_FLOATING_MENU=false

# Namespaces this app's JSON files inside the shared Blob store (local mode),
# and its keys in Redis.
TOOLS_NAME=barmeto-product-research

# ── Scraping services ────────────────────────────────────────────────────────
# Marketplaces show robot checks to requests from cloud servers, so pages go
# through scraping services, tried in SCRAPER_ORDER. A service with no key is
# skipped. When one runs out of credits (or fails, or is blocked) the next one
# is used; one that is out of credits is skipped for an hour.
# Check the setup with:  npm run scraper:check
#
# Level 1 — Firecrawl (https://firecrawl.dev → dashboard → API Keys).
#   Renders JavaScript (Meesho works); retries blocked pages with stronger
#   proxies at no extra cost; always asks for a fresh page (maxAge 0).
FIRECRAWL_API_KEY=""
# Level 2 — Scrape.do (https://scrape.do → dashboard → API token).
#   Cheap datacenter proxy first (1 credit); residential proxy (super, 10
#   credits / 25 with JS) only when the marketplace blocks it:
#   SCRAPEDO_SUPER=auto (default) | always | never
SCRAPEDO_TOKEN=""
SCRAPEDO_SUPER=auto
# Order to try them in. custom = SCRAPER_API_URL below; direct = no service
# (free; never used for Meesho, which needs JavaScript).
SCRAPER_ORDER="firecrawl,scrapedo,custom,direct"
# Optional level 3 — any other service's URL template with {url} in it, e.g.
#   https://app.scrapingbee.com/api/v1/?api_key=KEY&url={url}&render_js=false
# SCRAPER_API_URL_<MARKETPLACE> (e.g. SCRAPER_API_URL_MEESHO) overrides it for one.
# SCRAPER_API_URL=""
# Per page, milliseconds (each service gets this long).
SCRAPER_TIMEOUT_MS=45000

# ── Daily snapshot (Vercel Cron → GET /api/cron/refresh, vercel.json) ───────
# Vercel sends "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET="<random-secret>"

# ── Auth (JWT) — MUST match the root admin panel's values in connected mode ──
JWT_SECRET="<your-jwt-secret-min-64-chars>"
JWT_REFRESH_SECRET="<your-jwt-refresh-secret>"
NEXT_PUBLIC_SITE_URL="https://product-research.barmeto.com/"

# ── CORS — exact origins that call /api/* directly from the browser ──────────
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ── Framing — who may embed this app in an <iframe> ─────────────────────────
# The admin panel at NEXT_PUBLIC_ADMIN_API_URL (with and without "www.") is
# always allowed. List any OTHER site that embeds this tool here, as
# comma-separated origins; every site not listed is refused by the browser.
# Build-time (read by next.config.mjs) — rebuild after changing.
FRAME_ANCESTORS=""

# ── SMTP — Gmail App Password (login/reset OTP email) ───────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<your-sender-email>"
SMTP_PASS="<your-gmail-app-password>"
COMPANY_EMAIL_TO="<your-support-email>"

# ── MSG91 (mobile OTP) — optional; console-logs the OTP if unset ────────────
MSG91_AUTH_KEY="<your-msg91-authkey>"
MSG91_TEMPLATE_ID="<your-msg91-template-id>"
MSG91_OTP_VAR_NAME="VAR1"
MSG91_DEFAULT_COUNTRY_CODE="91"

# ── Vercel Blob — searches + daily product snapshots (+ auth in local mode) ─
# Unset → stored as JSON files under ./.data/ (local dev).
BLOB_STORE_ID="<your-blob-store-id>"
BLOB_READ_WRITE_TOKEN="<your-blob-read-write-token>"
